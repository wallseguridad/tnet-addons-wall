<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_header_clean" priority="1">
        <!-- requirement: header without content -->
    </template>

    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-if="not o.journal_id.l10n_latam_use_documents">
                <t t-set="custom_header" t-value="'wall_report_custom.custom_header_clean'"/>
            </t>
            <t t-set="address"></t>
            <div class="row mb-4">
                <div class="col-6">
                    <span><strong>Razón Social: </strong> <t t-esc="o.partner_id.display_name"/></span><br/>
                    <span><strong>Domicilio: </strong> <t t-esc="o.partner_id.street"/></span><br/>
                    <span><strong>Ubicación: </strong> <t t-esc="o.partner_id.city"/></span><br/>
                    <span><strong>Condición de venta: </strong></span> <span t-field="o.move_type"/><br/>
                </div>
                <div class="col-6 text-end">
                    <span><strong>Fecha Vencimiento: </strong> <span t-field="o.invoice_date_due"/></span><br/>
                    <span><strong>Cuit: </strong> <t t-esc="o.partner_id.vat"/></span><br/>
                    <span><strong>Cond. IVA: </strong> <t t-esc="o.partner_id.l10n_ar_afip_responsibility_type_id.display_name"/></span><br/>
                </div>
            </div>
        </xpath>
        <!-- v18: el <h2> del título pasó a layout_document_title; se vacía en lugar de
             eliminarlo porque l10n_ar.report_invoice_document lo busca para reemplazarlo -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title"/>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-attf-style">
                {{'display: none !important;'}}
            </attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>IVA</span></th>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="replace">
            <td name="td_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 15 else '' }}">
                <span t-out="', '.join(map(lambda x: (x.invoice_label or x.name), line.tax_ids))" id="line_tax_ids"/>
            </td>
        </xpath>
        <!-- la columna de descuento se mueve después de IVA y se muestra siempre -->
        <xpath expr="//th[@name='th_discount']" position="replace"/>
        <xpath expr="//th[@name='th_taxes']" position="after">
            <th name="th_discount" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Bonif</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="replace"/>
        <xpath expr="//td[@name='td_subtotal']" position="before">
            <td name="td_discount" t-attf-class="text-start text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span class="text-nowrap" t-field="line.discount"/>
                <span> %</span>
            </td>
        </xpath>
        <!-- no se muestra el recuadro de impuestos en moneda de la compañía; se anula el
             t-if en lugar de eliminarlo para no dejar huérfano el t-else que le sigue -->
        <xpath expr="//t[@t-call='account.document_tax_totals_company_currency_template']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- línea entre el total y lo pagado, igual a las del bloque de totales; va en la
             primera fila de pago que se imprime (las de diferencia de cambio se omiten) -->
        <xpath expr="//i[hasclass('oe_payment_label')]/../.." position="attributes">
            <attribute name="t-att-class">'border-black' if [p for p in payments_vals if p['is_exchange'] == 0][:1] == [payment_vals] else None</attribute>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_code" class="text-start" t-att-style="'display: none;' if without_sku else ''"><span>Código</span></th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="account_invoice_line_code" t-att-style="'display: none;' if without_sku else ''">
                <span t-field="line.product_id.default_code"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']//span" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">line.product_id._get_report_line_text(line.name)</attribute>
        </xpath>
    </template>

    <template id="report_invoice_document_l10n_ar_inherit" inherit_id="l10n_ar.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-attf-style">
                {{'display: none !important;'}}
            </attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>IVA</span></th>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-right">
                <span>Subtotal</span>
            </th>
        </xpath>
        <xpath expr="//span[@id='line_tax_ids']/.." position="replace">
            <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 15 else '' }}">
                <span t-esc="', '.join(map(lambda x: (x.invoice_label or x.name), line.tax_ids))" id="line_tax_ids"/>
            </td>
        </xpath>
    </template>

    <!-- account.tax_groups_totals fue eliminado en v18 — personalización de nombre de grupo pendiente
    <template id="tax_groups_totals_inherit" inherit_id="account.tax_groups_totals">
        <xpath expr="//t//tr//t//td//span[1]" position="replace">
            <t t-set="tax_group_name_split" t-value="amount_by_group['tax_group_name'].split(' ')"/>
            <t t-set="tax_group_name_percent" t-value="tax_group_name_split[1] if (len(tax_group_name_split) > 1) and ('%' in tax_group_name_split[1]) else amount_by_group['tax_group_name']"/>
            <span t-esc="tax_group_name_percent"/>
        </xpath>
    </template>
    -->

    <template id="stock_account_report_invoice_document_inherit" inherit_id="stock_account.stock_account_report_invoice_document">
        <xpath expr="//table[@name='invoice_snln_table']" position="replace"/>
    </template>

    <template id="report_accountmove_without_sku">
        <t t-call="web.html_container">
            <t t-set="without_sku" t-value="True"/>
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-set="print_with_payments" t-value="True"/>
                <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="lang"/>
                <t t-if="o._get_name_invoice_report() == 'l10n_ar.report_invoice_document'" t-call="l10n_ar.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

</odoo>