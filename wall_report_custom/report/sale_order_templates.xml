<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document" inherit_id="l10n_ar_sale.report_saleorder_document" priority="1" primary="True">
        <xpath expr="//div[@id='informations']/div[1]" position="replace">
            <div class="col-6">
                <span><strong>Razón Social: </strong> <t t-esc="doc.partner_id.display_name"/></span><br/>
                <span><strong>Dirección: </strong> <t t-esc="doc.partner_id.street"/></span><br/>
                <span><strong>Ubicación: </strong> <t t-esc="doc.partner_id.city"/></span><br/>
                <span><strong>Condición de venta: </strong> <span t-field="doc.picking_policy"/></span><br/>
                <span><strong>CUIT: </strong> <t t-esc="doc.partner_id.vat"/></span><br/>
            </div>
        </xpath>
        <xpath expr="//span[@t-field='line.product_uom']" position="replace"/>
        <xpath expr="//th[@name='th_discount']" position="replace"/>
        <xpath expr="//td[@t-if='display_discount']" position="replace"/>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" class="text-end">IVA</th>
            <th name="th_bonif" class="text-end">Bonif</th>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" class="text-end o_price_total">
                <span t-field="line.price_total"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="replace">
            <td name="td_taxes" class="text-end">
                <span t-out="', '.join(map(lambda x: (x.invoice_label or x.name), line.tax_id))"/>
            </td>
            <td name="td_bonif" class="text-end">
                <span t-field="line.discount"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_code" class="text-start" t-att-style="'display: none;' if without_sku else ''">Código</th>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_code" class="text-start" t-att-style="'display: none;' if without_sku else ''">
                <span t-field="line.product_id.default_code"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_name']//span" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">line.product_id._get_report_line_text(line.name)</attribute>
            <attribute name="t-options">{'widget': 'text'}</attribute>
        </xpath>
    </template>

    <!-- v18: l10n_ar_sale ya no elige el documento con _get_name_sale_report(), lo llama
         directo desde estos dos templates; se redirige esa llamada al documento de Wall -->
    <template id="report_saleorder_raw" inherit_id="l10n_ar_sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='l10n_ar_sale.report_saleorder_document']" position="attributes">
            <attribute name="t-call">wall_report_custom.report_saleorder_document</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_pro_forma" inherit_id="l10n_ar_sale.report_saleorder_pro_forma">
        <xpath expr="//t[@t-call='l10n_ar_sale.report_saleorder_document']" position="attributes">
            <attribute name="t-call">wall_report_custom.report_saleorder_document</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_without_sku">
        <t t-call="web.html_container">
            <t t-set="without_sku" t-value="True"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="wall_report_custom.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
