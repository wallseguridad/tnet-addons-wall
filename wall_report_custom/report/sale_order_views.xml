<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_saleorder_without_sku" model="ir.actions.report">
            <field name="name">Presupuesto / Pedido sin SKU</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">wall_report_custom.report_saleorder_without_sku</field>
            <field name="report_file">wall_report_custom.report_saleorder_without_sku</field>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Presupuesto - %s' % (object.name)) or 'Pedido - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>