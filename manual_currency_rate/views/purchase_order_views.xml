<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="currency_rate_purchase_order_form_view" model="ir.ui.view">
      <field name="name">currency.rate.purchase.order.form</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">

        <!-- Insert rates right after currency_id -->
        <xpath expr="//field[@name='currency_id']" position="after">
          <field name="l10n_ar_currency_rate_ids" nolabel="1" colspan="2"
                 readonly="state in ['done', 'cancel', 'purchase']"/>
        </xpath>

      </field>
    </record>

    <!-- List view for manual currency rates (purchase) -->
    <record id="currency_rate_purchase_tree_view" model="ir.ui.view">
      <field name="name">currency.rate.purchase.tree</field>
      <field name="model">l10n.ar.currency.rate.purchase</field>
      <field name="arch" type="xml">
        <tree>
          <field name="purchase_order_id"/>
          <field name="name"/>
          <field name="inverse_rate"/>
          <field name="manual_rate"/>
          <field name="date"/>
        </tree>
      </field>
    </record>

    <!-- Form view for manual currency rates (purchase) -->
    <record id="currency_rate_purchase_form_view" model="ir.ui.view">
      <field name="name">currency.rate.purchase.form</field>
      <field name="model">l10n.ar.currency.rate.purchase</field>
      <field name="arch" type="xml">
        <form>
          <group>
            <field name="purchase_order_id"/>
            <field name="name"/>
            <field name="inverse_rate" readonly="1"/>
            <field name="manual_rate"/>
            <field name="date" readonly="1"/>
          </group>
        </form>
      </field>
    </record>

  </data>
</odoo>

