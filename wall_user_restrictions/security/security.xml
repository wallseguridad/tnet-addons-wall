<?xml version="1.0" ?>

<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_wall">
            <field name="name">Wall Custom Permissions</field>
            <field name="sequence">60</field>
            <field name="visible" eval="0" />
        </record>
        <record id="sale_order_create_invoice" model="res.groups">
            <field name="name">Create Invoice in Sale Order</field>
            <field name="comment">Shows the create invoice button in sales orders</field>
            <field name="category_id" ref="wall_user_restrictions.module_category_wall"/>
            <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        </record>
        <record id="product_show_tab_purchase" model="res.groups">
            <field name="name">Show Tab Purchase in Products</field>
            <field name="comment">Shows Tab Purchase in Record Product</field>
            <field name="category_id" ref="wall_user_restrictions.module_category_wall"/>
           <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        </record>
        <record id="sale_order_readonly_price_unit" model="res.groups">
            <field name="name">Does not allow modifying sales price</field>
            <field name="comment">Does not allow modifying prices in quotes and orders</field>
            <field name="category_id" ref="wall_user_restrictions.module_category_wall"/>
        </record>
    </data>
</odoo>
