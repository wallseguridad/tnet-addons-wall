<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="show_create_invoice_view_order_form">
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='pricelist_id']" position="attributes">
                    <attribute name="attrs">{'readonly': False}</attribute>
                    <attribute name="readonly">0</attribute>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][1]" position="attributes">
                    <attribute name="groups">wall_user_restrictions.sale_order_create_invoice</attribute>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="attributes">
                    <attribute name="groups">wall_user_restrictions.sale_order_create_invoice</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                    <field name="readonly_price_unit" invisible="1"/>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('qty_invoiced', '&gt;', 0), ('readonly_price_unit', '!=', False)]}</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('readonly_price_unit', '!=', False)]}</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                <!--
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly': [('readonly_price_unit', '!=', False)]}</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                -->
            </field>
        </record>
    </data>
</odoo>
