<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="currency_manual_rate_tree_view" model="ir.ui.view">
            <field name="name">currency.manual.rate.tree</field>
            <field name="model">res.currency</field>
            <field name="inherit_id" ref="base.view_currency_tree"/>
            <field name="arch" type="xml">
				<field name="active" position="after" >
                    <field name="l10n_ar_use_manual_rate" widget="boolean_toggle"/>
				</field>
            </field>
        </record>

        <record id="currency_manual_rate_form_view" model="ir.ui.view">
            <field name="name">currency.manual.rate.form</field>
            <field name="model">res.currency</field>
            <field name="inherit_id" ref="base.view_currency_form"/>
            <field name="arch" type="xml">
				<field name="currency_subunit_label" position="after" >
                    <field name="l10n_ar_use_manual_rate" widget="boolean_toggle"/>
				</field>
            </field>
        </record>
    </data>
</odoo>