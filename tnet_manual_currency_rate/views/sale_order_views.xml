<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="currency_rate_sale_order_form_view" model="ir.ui.view">
            <field name="name">currency.rate.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="payment_term_id" position="after">
                    <field name="l10n_ar_currency_rate_ids" nolabel="1" colspan="2" readonly="state in ('done', 'cancel')">
                        <list create="0" delete="0" editable="top">
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="date" readonly="1" force_save="1"/>
                            <field name="inverse_rate" readonly="1" force_save="1"/>
                            <field name="manual_rate"/>
                        </list>
                    </field>
                </field>
                <xpath expr="//group[@name='order_details']" position="attributes">
                    <attribute name="style">width: 49% !important</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="before">
                    <field name="l10n_ar_price_unit_usd" readonly="1" force_save="1"/>
                </xpath>
                <!-- El core deja order_line entero readonly cuando locked=True
                     (independiente de state). Wall necesita reprecio por TC
                     manual en confirmados: se saca 'locked' de la condición,
                     el resto de los campos (qty, producto, etc.) los sigue
                     protegiendo sale.order.line._get_protected_fields() del
                     lado del servidor igual. -->
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']" position="attributes">
                    <attribute name="readonly">state == 'cancel'</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>