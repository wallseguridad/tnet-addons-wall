<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="currency_rate_purchase_order_form_view" model="ir.ui.view">
            <field name="name">currency.rate.purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <field name="currency_id" position="after">
                    <field name="l10n_ar_currency_rate_ids" nolabel="1" colspan="2" style="width: 95% !important;" readonly="state in ('done', 'cancel')">
                        <list create="0" delete="0" editable="top">
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="date" readonly="1" force_save="1"/>
                            <field name="inverse_rate" readonly="1" force_save="1"/>
                            <field name="manual_rate"/>
                        </list>
                    </field>
                </field>
                <xpath expr="//form/sheet/notebook/page[@name='products']/field[@name='order_line']/list/field[@name='price_unit']" position="before">
                    <field name="l10n_ar_price_unit_usd" readonly="1" force_save="1"/>
                    <button name="action_update_standard_price" icon="fa-repeat" type="object" title="Update Standard Price" invisible="not product_id"/>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="attributes">
                    <attribute name="readonly">state in ('done', 'cancel')</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>