<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Fix 1: Permitir editar tasas de cambio en state='sale' -->
    <record id="wall_sale_currency_rate_form" model="ir.ui.view">
      <field name="name">wall.sale.currency.rate.form</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="manual_currency_rate_sale.currency_rate_sale_order_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='l10n_ar_currency_rate_ids']" position="attributes">
          <attribute name="readonly">state in ['done', 'cancel']</attribute>
        </xpath>
      </field>
    </record>

    <!-- Fix 2: Permitir editar lista de precios en state='sale' -->
    <record id="wall_sale_pricelist_editable_form" model="ir.ui.view">
      <field name="name">wall.sale.pricelist.editable.form</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='pricelist_id']" position="attributes">
          <attribute name="readonly">state in ['done', 'cancel']</attribute>
        </xpath>
      </field>
    </record>

    <!-- Fix 3: sale_order_general_discount (OCA) inyecta {'default_discount': general_discount}
         en el contexto de order_line via get_view. En Odoo 18, OWL evalúa ese contexto durante
         Record._setData, antes de que general_discount esté disponible porque order_line aparece
         antes en el arch. Este xpath lo agrega como campo invisible antes de order_line para
         garantizar que esté en el eval context cuando se evalúe el contexto de order_line. -->
    <record id="wall_general_discount_eval_context_fix" model="ir.ui.view">
      <field name="name">wall.general.discount.eval.context.fix</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='order_line']" position="before">
          <field name="general_discount" invisible="1"/>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
