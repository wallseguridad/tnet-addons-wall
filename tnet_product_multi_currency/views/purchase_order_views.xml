<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="multi_currency_purchase_order_form_view" model="ir.ui.view">
            <field name="name">multi.currency.purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[@name='products']/field[@name='order_line']/list/field[@name='price_unit']" position="before">
                    <field name="standard_price" readonly="1" force_save="1"/>
                    <field name="cost_currency_id" readonly="1" force_save="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>