        <record id="multi_currency_product_template_form_view" model="ir.ui.view">
            <field name="name">multi.currency.product.template.form</field>
            <field name="model">product.template</field>
			<field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
				<xpath expr="//form/sheet/notebook/page[@name='purchase']/group[@name='purchase']/group[@name='bill']" position="after">
                    <group string="Cost and Sales Prices" name="cost_sales_prices">
                        <label for="list_price" class="mt-1"/>
                        <div name="pricing">
                          <field name="list_price" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                          <field name="property_currency_id" class="oe_inline" style="width: 40% !important; margin-left: 5px;" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        </div>
                        <label for="standard_price" groups="base.group_user" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div name="standard_price_uom" groups="base.group_user" invisible="product_variant_count &gt; 1 and not is_product_variant" class="o_row">
                            <field name="standard_price" widget="monetary" options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                            <field name="property_cost_currency_id" class="oe_inline" style="margin-left: 5px;" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <span groups="uom.group_uom" class="oe_read_only">
                                <field name="uom_name"/>
                            </span>
                        </div>
                    </group>
				</xpath>
                <xpath expr="//form/sheet/notebook/page[@name='general_information']/group/group[@name='group_standard_price']/label[@for='standard_price']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='general_information']/group/group[@name='group_standard_price']/div[@name='standard_price_uom']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
			</field>
        </record>
    </data>
</odoo>